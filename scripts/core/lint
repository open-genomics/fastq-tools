#!/bin/bash
# scripts/core/lint
# 
# FastQTools 代码质量检查脚本 - 统一的格式化和静态分析工具
# 
# 使用示例:
#   ./scripts/core/lint check                # 检查代码风格
#   ./scripts/core/lint format               # 自动格式化
#   ./scripts/core/lint tidy                 # 运行 clang-tidy
#   ./scripts/core/lint all                  # 运行所有检查

set -euo pipefail

# 加载公共函数库
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/toolchain.env"

# =============================================================================
# 默认配置
# =============================================================================
COMMAND="check"
BUILD_DIR=""
STYLE_FILE=".clang-format"
TIDY_CONFIG=".clang-tidy"
FIX=false
VERBOSE=false
PRESET=""

# =============================================================================
# 帮助信息
# =============================================================================
print_usage() {
    print_usage_header "FastQTools 代码质量工具" "统一的代码格式化和静态分析工具"
    
    cat << 'EOF'
命令:
  check                     检查代码风格 (默认)
  format                    自动格式化代码
  format-check              仅检查格式（不修改）
  tidy                      运行 clang-tidy 静态分析
  tidy-fix                  运行 clang-tidy 并自动修复
  cppcheck                  运行 Cppcheck 静态分析
  iwyu                      运行 Include-What-You-Use 分析
  all                       运行所有检查 (format + tidy + cppcheck)
  
 选项:
  -b, --build-dir DIR       构建目录（包含 compile_commands.json）
  -p, --preset NAME         使用指定 preset 对应的构建目录
  -s, --style FILE          clang-format 样式文件 (默认: .clang-format)
  -t, --tidy-config FILE    clang-tidy 配置文件 (默认: .clang-tidy)
  -v, --verbose             详细输出
  -h, --help                显示此帮助信息

示例:
  ./scripts/core/lint check                   # 检查代码风格
  ./scripts/core/lint format                  # 格式化所有代码
  ./scripts/core/lint tidy --preset clang-debug # 运行静态分析
  ./scripts/core/lint tidy-fix                # 自动修复问题
  ./scripts/core/lint all                     # 运行所有检查
EOF
}

# =============================================================================
# 检查工具可用性
# =============================================================================
check_tools() {
    local required_tools=("$@")
    local missing=()
    
    for tool in "${required_tools[@]}"; do
        if ! command -v "$tool" &>/dev/null; then
            missing+=("$tool")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "缺少必需工具: ${missing[*]}"
        log_info "安装提示（clang 工具链须与 CI 同源 apt.llvm.org）:"
        log_info "  Ubuntu/Debian: curl -fsSL https://apt.llvm.org/llvm.sh | sudo bash -s -- ${EXPECTED_LLVM_VERSION}"
        log_info "  macOS: brew install llvm && brew link --force llvm"
        return 1
    fi
    return 0
}

# =============================================================================
# 版本守卫：clang-format 的版本必须与 CI 对齐（见 toolchain.env）。
# 版本漂移是真实事故——uv/pip 装的旧版遮蔽系统工具链时，lint 会用错误版本
# 产出与 CI（LLVM 21）相反的格式意见。这里把"PATH 里恰好是谁"变成显式校验：
# 解析到非预期大版本时直接报错退出，而不是带着错误版本继续产出误导性结论。
# =============================================================================
require_clang_format_version() {
    if ! command -v clang-format &>/dev/null; then
        log_error "clang-format 未安装"
        return 1
    fi
    local version
    version="$(clang-format --version 2>/dev/null | grep -oE '[0-9]+' | head -1)"
    if [[ -z "$version" ]]; then
        log_error "无法解析 clang-format 版本"
        return 1
    fi
    if [[ "$version" != "${EXPECTED_LLVM_VERSION}" ]]; then
        log_error "clang-format 版本不匹配: 实际 ${version}.x，要求 ${EXPECTED_LLVM_VERSION}.x"
        log_error "解析路径: $(command -v clang-format)"
        log_info "运行 ./scripts/core/doctor 查看对齐/修复步骤"
        return 1
    fi
    return 0
}

# =============================================================================
# 格式化函数
# =============================================================================
run_format_check() {
    log_info "检查代码格式..."
    
    local files
    files=$(find src include tests \
        -type f \
        \( -name "*.cpp" -o -name "*.h" -o -name "*.hpp" \) \
        2>/dev/null)
    
    if [[ -z "$files" ]]; then
        log_warning "未找到需要检查的文件"
        return 0
    fi
    
    local issues=0
    while IFS= read -r file; do
        if ! clang-format --style=file:"$STYLE_FILE" --dry-run --Werror "$file" 2>/dev/null; then
            log_error "格式问题: $file"
            ((++issues))
        fi
    done <<< "$files"
    
    if [[ $issues -eq 0 ]]; then
        log_success "代码格式检查通过 ✓"
        return 0
    else
        log_error "发现 ${issues} 个文件有格式问题"
        log_info "运行 './scripts/core/lint format' 自动修复"
        return 1
    fi
}

run_format() {
    log_info "格式化代码..."
    
    local files
    files=$(find src include tests \
        -type f \
        \( -name "*.cpp" -o -name "*.h" -o -name "*.hpp" \) \
        2>/dev/null)
    
    if [[ -z "$files" ]]; then
        log_warning "未找到需要格式化的文件"
        return 0
    fi
    
    local count=0
    while IFS= read -r file; do
        if [[ "$VERBOSE" == "true" ]]; then
            log_debug "格式化: $file"
        fi
        clang-format --style=file:"$STYLE_FILE" -i "$file"
        ((++count))
    done <<< "$files"
    
    log_success "已格式化 ${count} 个文件 ✓"
    return 0
}

# =============================================================================
# Cppcheck 函数
# =============================================================================
run_cppcheck() {
    log_info "运行 Cppcheck 静态分析..."
    
    if ! check_tools cppcheck; then
        log_error "Cppcheck 未安装"
        log_info "安装提示: sudo apt-get install cppcheck / brew install cppcheck"
        return 1
    fi
    
    local cppcheck_args=(
        --enable=warning,style,performance,portability
        --std=c++23
        --error-exitcode=1
        --inline-suppr
        --quiet
    )
    
    # 使用抑制文件
    local suppression_file="${PROJECT_ROOT}/build-config/cppcheck/suppressions.txt"
    if [[ -f "$suppression_file" ]]; then
        cppcheck_args+=(--suppressions-list="$suppression_file")
    fi
    
    # 使用编译数据库（如果存在）
    if [[ -n "$BUILD_DIR" && -f "${BUILD_DIR}/compile_commands.json" ]]; then
        cppcheck_args+=(--project="${BUILD_DIR}/compile_commands.json")
    else
        cppcheck_args+=(src include)
    fi
    
    if [[ "$VERBOSE" == "true" ]]; then
        cppcheck_args+=(--verbose)
        log_debug "Cppcheck 参数: ${cppcheck_args[*]}"
    fi
    
    local issues=0
    if ! cppcheck "${cppcheck_args[@]}" 2>&1; then
        issues=1
    fi
    
    if [[ $issues -eq 0 ]]; then
        log_success "Cppcheck 分析通过 ✓"
        return 0
    else
        log_error "Cppcheck 发现问题"
        return 1
    fi
}

# =============================================================================
# IWYU 函数
# =============================================================================
run_iwyu() {
    log_info "运行 Include-What-You-Use 分析..."
    
    if ! check_tools include-what-you-use; then
        log_error "Include-What-You-Use 未安装"
        log_info "安装提示: sudo apt-get install iwyu / brew install include-what-you-use"
        return 1
    fi
    
    # 确定构建目录
    if [[ -z "$BUILD_DIR" ]]; then
        BUILD_DIR=$(find_compile_commands_dir 2>/dev/null || true)
    fi
    
    if [[ -z "$BUILD_DIR" || ! -f "${BUILD_DIR}/compile_commands.json" ]]; then
        log_error "未找到编译数据库"
        log_info "请先运行构建或使用 -b 指定构建目录"
        return 1
    fi
    
    log_info "使用编译数据库: ${BUILD_DIR}/compile_commands.json"
    
    local mapping_file="${PROJECT_ROOT}/build-config/iwyu/mappings.imp"
    local iwyu_args=(-p "$BUILD_DIR")
    
    if [[ -f "$mapping_file" ]]; then
        iwyu_args+=(-Xiwyu --mapping_file="$mapping_file")
    fi
    
    # 收集源文件
    local files
    files=$(find src -type f -name "*.cpp" 2>/dev/null | head -20)
    
    if [[ -z "$files" ]]; then
        log_warning "未找到需要分析的文件"
        return 0
    fi
    
    local issues=0
    local count=0
    
    while IFS= read -r file; do
        ((++count))
        if [[ "$VERBOSE" == "true" ]]; then
            log_debug "分析 [${count}]: $file"
        fi
        
        # IWYU 返回非零表示有建议，不一定是错误
        include-what-you-use "${iwyu_args[@]}" "$file" 2>&1 || true
    done <<< "$files"
    
    log_success "IWYU 分析完成 (检查了 ${count} 个文件)"
    log_info "注意: IWYU 的建议需要人工审核，不是所有建议都需要采纳"
    return 0
}

# =============================================================================
# Clang-Tidy 函数
# =============================================================================
run_tidy() {
    local fix_mode="$1"
    
    log_info "运行 clang-tidy 静态分析..."
    
    # 确定构建目录
    if [[ -z "$BUILD_DIR" ]]; then
        # 尝试查找编译数据库
        BUILD_DIR=$(find_compile_commands_dir 2>/dev/null || true)
        
        if [[ -z "$BUILD_DIR" ]]; then
            log_error "未找到构建目录"
            log_info "请先运行构建或使用 -b 指定构建目录"
            return 1
        fi
    fi
    
    if [[ ! -f "${BUILD_DIR}/compile_commands.json" ]]; then
        log_error "未找到编译数据库: ${BUILD_DIR}/compile_commands.json"
        log_info "请使用 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON 重新构建"
        return 1
    fi
    
    log_info "使用编译数据库: ${BUILD_DIR}/compile_commands.json"

    local python_cmd=""
    if command -v python3 &>/dev/null; then
        python_cmd="python3"
    elif command -v python &>/dev/null; then
        python_cmd="python"
    else
        log_error "运行 clang-tidy 需要 python3 或 python 来解析 compile_commands.json"
        return 1
    fi

    # GCC 15+ 生成的 compile_commands.json 包含 clang-tidy 不认识的 flag，
    # 创建过滤后的编译数据库供 clang-tidy 使用
    local tidy_build_dir="${BUILD_DIR}/clang-tidy-filtered"
    mkdir -p "$tidy_build_dir"
    "${python_cmd}" - "${BUILD_DIR}/compile_commands.json" "${tidy_build_dir}/compile_commands.json" <<'PY'
import json, sys

src, dst = sys.argv[1], sys.argv[2]
with open(src, encoding="utf-8") as f:
    entries = json.load(f)

bad_prefixes = ("-fdeps-format=", "-fmodule-mapper=", "-fmodules-ts")
for entry in entries:
    cmd = entry.get("command", "")
    if cmd:
        parts = cmd.split()
        filtered = [p for p in parts if not any(p.startswith(b) for b in bad_prefixes)]
        entry["command"] = " ".join(filtered)

with open(dst, "w", encoding="utf-8") as f:
    json.dump(entries, f)
PY
    log_info "使用过滤后的编译数据库: ${tidy_build_dir}/compile_commands.json"
    BUILD_DIR="$tidy_build_dir"

    # 仅分析当前编译数据库中的翻译单元，避免扫描未进入当前构建图的源文件。
    local files
    files=$("${python_cmd}" - "${BUILD_DIR}/compile_commands.json" <<'PY'
import json
import os
import sys

project_root = os.getcwd()
compile_commands_path = sys.argv[1]

with open(compile_commands_path, encoding="utf-8") as handle:
    compile_commands = json.load(handle)

seen = set()
selected = []
for entry in compile_commands:
    file_path = entry.get("file")
    if not file_path:
        continue
    absolute_path = os.path.abspath(file_path)
    if not absolute_path.startswith(os.path.join(project_root, "src") + os.sep):
        continue
    if not absolute_path.endswith((".c", ".cc", ".cpp", ".cxx")):
        continue
    if absolute_path in seen:
        continue
    seen.add(absolute_path)
    selected.append(os.path.relpath(absolute_path, project_root))

for file_path in selected:
    print(file_path)
PY
)

    if [[ -z "$files" ]]; then
        log_warning "未找到需要分析的文件"
        return 0
    fi
    
    local tidy_args=(
        -p "$BUILD_DIR"
    )
    
    if [[ "$fix_mode" == "fix" ]]; then
        tidy_args+=(--fix --fix-errors)
        log_info "自动修复模式已启用"
    fi
    
    if [[ "$VERBOSE" == "false" ]]; then
        tidy_args+=(--quiet)
    fi
    
    local issues=0
    local count=0
    
    while IFS= read -r file; do
        ((++count))
        if [[ "$VERBOSE" == "true" ]]; then
            log_debug "分析 [${count}]: $file"
        fi
        
        local tidy_output=""
        local tidy_rc=0
        tidy_output=$(clang-tidy "${tidy_args[@]}" "$file" 2>&1) || tidy_rc=$?

        if [[ -n "${tidy_output}" ]]; then
            printf '%s\n' "${tidy_output}"
        fi

        # 退出码 1 且有输出视为正常检出 warning/error；其他退出码（段错误、配置错误等）
        # 或退出码非零却无输出，一律视为 clang-tidy 执行失败，避免工具崩溃被静默判为通过
        if [[ $tidy_rc -ne 0 && ( $tidy_rc -ne 1 || -z "${tidy_output}" ) ]]; then
            log_error "clang-tidy 执行异常 (退出码 ${tidy_rc}): $file"
            return 1
        fi

        if grep -Eq "warning:|error:" <<< "${tidy_output}"; then
            ((++issues))
        fi
    done <<< "$files"

    if [[ $issues -eq 0 ]]; then
        log_success "静态分析通过 ✓ (检查了 ${count} 个文件)"
        return 0
    else
        log_warning "发现 ${issues} 个文件有问题"
        if [[ "$fix_mode" != "fix" ]]; then
            log_info "运行 './scripts/core/lint tidy-fix' 尝试自动修复"
        fi
        return 1
    fi
}

# =============================================================================
# 参数解析
# =============================================================================
if [[ $# -gt 0 ]]; then
    case "$1" in
        check|format|format-check|tidy|tidy-fix|cppcheck|iwyu|all)
            COMMAND="$1"
            shift
            ;;
    esac
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        -b|--build-dir)
            BUILD_DIR="$2"
            shift 2
            ;;
        -p|--preset)
            PRESET="$2"
            shift 2
            ;;
        -s|--style)
            STYLE_FILE="$2"
            shift 2
            ;;
        -t|--tidy-config)
            TIDY_CONFIG="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            log_error "未知选项: $1"
            print_usage
            exit 1
            ;;
    esac
done

# =============================================================================
# 执行命令
# =============================================================================
PROJECT_ROOT=$(get_project_root)
cd "$PROJECT_ROOT"

start_timer

log_section "FastQTools 代码质量检查"

if [[ -z "$BUILD_DIR" && -n "$PRESET" ]]; then
    BUILD_DIR=$(get_build_dir "clang" "Debug" "" "false" "$PRESET")
fi

case "$COMMAND" in
    check|format-check)
        check_tools clang-format || exit 1
        require_clang_format_version || exit 1
        run_format_check && RESULT=0 || RESULT=$?
        ;;
        
    format)
        check_tools clang-format || exit 1
        require_clang_format_version || exit 1
        run_format && RESULT=0 || RESULT=$?
        ;;
        
    tidy)
        check_tools clang-tidy || exit 1
        run_tidy "check" && RESULT=0 || RESULT=$?
        ;;
        
    tidy-fix)
        check_tools clang-tidy || exit 1
        run_tidy "fix" && RESULT=0 || RESULT=$?
        ;;
        
    all)
        check_tools clang-format clang-tidy || exit 1
        require_clang_format_version || exit 1
        
        log_info "步骤 1/3: 代码格式检查"
        run_format_check && FORMAT_RESULT=0 || FORMAT_RESULT=$?
        
        log_separator "-"
        
        log_info "步骤 2/3: Clang-Tidy 静态分析"
        run_tidy "check" && TIDY_RESULT=0 || TIDY_RESULT=$?
        
        log_separator "-"
        
        log_info "步骤 3/3: Cppcheck 静态分析"
        run_cppcheck && CPPCHECK_RESULT=0 || CPPCHECK_RESULT=$?
        
        if [[ $FORMAT_RESULT -eq 0 && $TIDY_RESULT -eq 0 && $CPPCHECK_RESULT -eq 0 ]]; then
            RESULT=0
        else
            RESULT=1
        fi
        ;;
        
    cppcheck)
        run_cppcheck && RESULT=0 || RESULT=$?
        ;;
        
    iwyu)
        run_iwyu && RESULT=0 || RESULT=$?
        ;;
        
    *)
        log_error "未知命令: $COMMAND"
        print_usage
        exit 1
        ;;
esac

log_separator "="

if [[ $RESULT -eq 0 ]]; then
    log_success "代码质量检查通过 ✓"
    end_timer
else
    log_error "代码质量检查失败 ✗"
fi

log_separator "="

exit $RESULT
