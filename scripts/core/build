#!/bin/bash
# scripts/core/build
# 
# FastQTools 统一构建脚本 - 支持开发和生产环境
# 
# 使用示例:
#   ./scripts/core/build                           # 默认: clang Release
#   ./scripts/core/build --compiler gcc --type Debug
#   ./scripts/core/build --dev                     # 开发模式: Debug + 详细输出
#   ./scripts/core/build --sanitizer asan          # AddressSanitizer 构建
#   ./scripts/core/build --coverage                # 覆盖率构建
#   ./scripts/core/build --preset clang-release    # 使用 CMake preset

set -euo pipefail

# 加载公共函数库
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/common.sh"

# pip --user 安装的 conan 可能不在 PATH，先探测用户脚本目录
ensure_pip_user_bin_in_path

# =============================================================================
# 默认配置
# =============================================================================
COMPILER="clang"
BUILD_TYPE="Release"
BUILD_DIR=""
SANITIZER=""
COVERAGE=false
STATIC_ANALYSIS=false
LTO=true
CPU_BASELINE=""
VERBOSE=false
DEV_MODE=false
PRESET=""
CLEAN=false
JOBS=$(get_cpu_cores)

BUILD_DIR_DEFAULTED=false
CONAN_COMPILER_VERSION_OVERRIDE=""
CONAN_PROFILE_OVERRIDE=""
COMPILER_EXPLICIT=false
BUILD_TYPE_EXPLICIT=false
ACTIVE_PRESET=""
USE_CMAKE_PRESET=false

# =============================================================================
# 帮助信息
# =============================================================================
print_usage() {
    print_usage_header "FastQTools Build System" "统一的构建脚本，支持多种编译器、构建类型和分析工具"
    
    cat << 'EOF'
基本选项:
  -c, --compiler NAME       编译器: gcc | clang (默认: clang)
  -t, --type TYPE           构建类型: Debug | Release | RelWithDebInfo | Coverage (默认: Release)
  -d, --dev                 开发模式 (等同于 --type Debug --verbose)
  -j, --jobs N              并行编译任务数 (默认: 自动检测)
  -b, --build-dir DIR       自定义构建目录 (默认: 与 preset/构建模式一致)
  
高级选项:
  -s, --sanitizer TYPE      启用 Sanitizer: asan | tsan | ubsan
  -C, --coverage            启用代码覆盖率
  --static-analysis         启用静态分析 (clang-tidy)
  --conan-compiler-version VERSION  覆盖 Conan 使用的编译器版本
  --conan-profile PATH      显式指定 Conan host profile
  --no-lto                  禁用链接时优化
  --cpu-baseline PROFILE     CPU 基线: portable | x86-64-v3 | native (默认: portable)
  --clean                   构建前清理构建目录
  -p, --preset NAME         使用 CMake preset (覆盖其他选项)
  
输出控制:
  -v, --verbose             详细输出
  -q, --quiet               静默模式
  
其他:
  -h, --help                显示此帮助信息

示例:
  ./scripts/core/build                               # 标准 Release 构建
  ./scripts/core/build --dev                         # 快速开发构建
  ./scripts/core/build -c gcc -t Debug -v            # GCC Debug 详细输出
  ./scripts/core/build --sanitizer asan              # AddressSanitizer 构建
  ./scripts/core/build --coverage                    # 覆盖率构建
  ./scripts/core/build --preset clang-release --clean # 使用 preset 并清理
EOF
}

# =============================================================================
# 参数解析
# =============================================================================
while [[ $# -gt 0 ]]; do
    case $1 in
        -c|--compiler)
            COMPILER=$(normalize_compiler "$2") || exit 1
            COMPILER_EXPLICIT=true
            shift 2
            ;;
        -t|--type)
            BUILD_TYPE=$(normalize_build_type "$2") || exit 1
            BUILD_TYPE_EXPLICIT=true
            shift 2
            ;;
        -d|--dev)
            DEV_MODE=true
            BUILD_TYPE="Debug"
            BUILD_TYPE_EXPLICIT=true
            VERBOSE=true
            shift
            ;;
        -j|--jobs)
            JOBS="$2"
            shift 2
            ;;
        -b|--build-dir)
            BUILD_DIR="$2"
            shift 2
            ;;
        -s|--sanitizer)
            SANITIZER=$(normalize_sanitizer "$2") || exit 1
            shift 2
            ;;
        -C|--coverage)
            COVERAGE=true
            BUILD_TYPE="Debug"
            BUILD_TYPE_EXPLICIT=true
            shift
            ;;
        --static-analysis)
            STATIC_ANALYSIS=true
            shift
            ;;
        --conan-compiler-version)
            CONAN_COMPILER_VERSION_OVERRIDE="$2"
            shift 2
            ;;
        --conan-profile)
            CONAN_PROFILE_OVERRIDE="$2"
            shift 2
            ;;
        --no-lto)
            LTO=false
            shift
            ;;
        --cpu-baseline)
            CPU_BASELINE="$2"
            shift 2
            ;;
        --clean)
            CLEAN=true
            shift
            ;;
        -p|--preset)
            PRESET="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -q|--quiet)
            VERBOSE=false
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            log_error "未知选项: $1"
            print_usage
            exit 1
            ;;
    esac
done

if [[ "$BUILD_TYPE" == "Coverage" ]]; then
    COVERAGE=true
    BUILD_TYPE="Debug"
fi

if [[ "$COVERAGE" == "true" && "$COMPILER_EXPLICIT" == "false" ]]; then
    COMPILER="gcc"
fi

if [[ -n "$SANITIZER" && "$BUILD_TYPE_EXPLICIT" == "false" ]]; then
    BUILD_TYPE="Debug"
fi

if [[ -n "$PRESET" && -n "$BUILD_DIR" ]]; then
    log_error "--preset 不能与 --build-dir 同时使用"
    exit 1
fi

case "$PRESET" in
    gcc-debug)
        COMPILER="gcc"
        BUILD_TYPE="Debug"
        SANITIZER=""
        COVERAGE=false
        ;;
    gcc-release)
        COMPILER="gcc"
        BUILD_TYPE="Release"
        SANITIZER=""
        COVERAGE=false
        ;;
    gcc-relwithdebinfo)
        COMPILER="gcc"
        BUILD_TYPE="RelWithDebInfo"
        SANITIZER=""
        COVERAGE=false
        ;;
    clang-debug)
        COMPILER="clang"
        BUILD_TYPE="Debug"
        SANITIZER=""
        COVERAGE=false
        ;;
    clang-release)
        COMPILER="clang"
        BUILD_TYPE="Release"
        SANITIZER=""
        COVERAGE=false
        ;;
    clang-asan)
        COMPILER="clang"
        BUILD_TYPE="Debug"
        SANITIZER="asan"
        COVERAGE=false
        ;;
    clang-tsan)
        COMPILER="clang"
        BUILD_TYPE="Debug"
        SANITIZER="tsan"
        COVERAGE=false
        ;;
    clang-ubsan)
        COMPILER="clang"
        BUILD_TYPE="Debug"
        SANITIZER="ubsan"
        COVERAGE=false
        ;;
    clang-msan)
        COMPILER="clang"
        BUILD_TYPE="Debug"
        SANITIZER="msan"
        COVERAGE=false
        ;;
    coverage)
        COMPILER="gcc"
        BUILD_TYPE="Debug"
        SANITIZER=""
        COVERAGE=true
        ;;
    "")
        ;;
    *)
        log_warning "未知 preset: ${PRESET}，将按名称映射构建目录并继续"
        ;;
esac

# clang-* preset 无条件加 -stdlib=libc++；ARM 的 Conan profile 统一用
# libstdc++，混用会在链接期出现 ABI 冲突。提前给出明确错误，而不是让
# 用户看到一长串 CMake/链接失败。
if [[ -n "$PRESET" && "$(detect_os)" == "linux" &&
    "$(uname -m 2>/dev/null)" =~ ^(aarch64|arm64)$ ]]; then
    case "$PRESET" in
        clang-*)
            log_error "ARM64 上不支持 preset '${PRESET}'（强制 -stdlib=libc++）"
            log_info "请去掉 --preset，使用默认构建路径；或改用 --compiler gcc"
            exit 1
            ;;
    esac
fi

# =============================================================================
# 环境检查
# =============================================================================
PROJECT_ROOT=$(get_project_root)
cd "$PROJECT_ROOT"

start_timer

log_section "FastQTools 构建系统"

# 检查必需的命令
show_step 1 4 "检查构建环境"
require_commands cmake ninja || {
    log_error "缺少必需的构建工具"
    log_info "请运行: ./scripts/core/install-deps --dev"
    exit 1
}

# 检查编译器
if ! require_command "${COMPILER}"; then
    log_error "编译器 ${COMPILER} 未找到"
    exit 1
fi

# =============================================================================
# 配置构建目录
# =============================================================================
if [[ -z "$BUILD_DIR" ]]; then
    ACTIVE_PRESET="$PRESET"
    if [[ -z "$ACTIVE_PRESET" ]]; then
        ACTIVE_PRESET=$(get_default_cmake_preset "$COMPILER" "$BUILD_TYPE" "$SANITIZER" "$COVERAGE" 2>/dev/null || true)
    fi
    BUILD_DIR=$(get_build_dir "$COMPILER" "$BUILD_TYPE" "$SANITIZER" "$COVERAGE" "$ACTIVE_PRESET")
    BUILD_DIR_DEFAULTED=true
else
    ACTIVE_PRESET="$PRESET"
fi

if [[ -n "$ACTIVE_PRESET" && "$BUILD_DIR_DEFAULTED" == "true" ]]; then
    USE_CMAKE_PRESET=true
fi

log_info "项目根目录: ${PROJECT_ROOT}"
log_info "构建目录: ${BUILD_DIR}"
[[ -n "$ACTIVE_PRESET" ]] && log_info "CMake preset: ${ACTIVE_PRESET}"
log_info "编译器: ${COMPILER}"
log_info "主机架构: $(uname -m 2>/dev/null || echo unknown)"
log_info "构建类型: ${BUILD_TYPE}"
[[ -n "$SANITIZER" ]] && log_info "Sanitizer: ${SANITIZER}"
[[ "$COVERAGE" == "true" ]] && log_info "覆盖率: 已启用"
[[ "$STATIC_ANALYSIS" == "true" ]] && log_info "静态分析: 已启用"
log_info "并行任务: ${JOBS}"
[[ -n "$CPU_BASELINE" ]] && log_info "CPU 基线: ${CPU_BASELINE}"

# =============================================================================
# 清理（如果需要）
# =============================================================================
if [[ "$CLEAN" == "true" ]]; then
    log_warning "清理构建目录: ${BUILD_DIR}"
    safe_remove_dir "$BUILD_DIR"
fi

ensure_directory "$BUILD_DIR"

# =============================================================================
# 构建 CMake 参数
# =============================================================================
CMAKE_ARGS=()

if [[ "$USE_CMAKE_PRESET" == "true" ]]; then
    CMAKE_ARGS=(--preset "$ACTIVE_PRESET")
else
    CMAKE_ARGS=(
        -S .
        -B "$BUILD_DIR"
        -G Ninja
        -DCMAKE_BUILD_TYPE="$BUILD_TYPE"
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
    )
fi

# 编译器设置
C_COMPILER_BIN="${COMPILER}"
CXX_COMPILER_BIN="${COMPILER}++"
if [[ "${COMPILER}" == "gcc" ]]; then
    CXX_COMPILER_BIN="g++"
elif [[ "${COMPILER}" == "clang" ]]; then
    CXX_COMPILER_BIN="clang++"
fi

if [[ "$USE_CMAKE_PRESET" == "false" ]]; then
    CMAKE_ARGS+=(
        -DCMAKE_C_COMPILER="${C_COMPILER_BIN}"
        -DCMAKE_CXX_COMPILER="${CXX_COMPILER_BIN}"
    )
fi

# Sanitizer
if [[ -n "$SANITIZER" ]]; then
    case "$SANITIZER" in
        asan)
            CMAKE_ARGS+=(-DENABLE_ASAN=ON)
            ;;
        tsan)
            CMAKE_ARGS+=(-DENABLE_TSAN=ON)
            ;;
        ubsan)
            CMAKE_ARGS+=(-DENABLE_UBSAN=ON)
            ;;
        msan)
            if [[ "${COMPILER}" != "clang" ]]; then
                log_error "MemorySanitizer (msan) 仅支持 Clang 编译器"
                exit 1
            fi
            CMAKE_ARGS+=(-DENABLE_MSAN=ON)
            ;;
        *)
            log_error "未知的 sanitizer: ${SANITIZER}"
            log_info "支持的 sanitizer: asan, tsan, ubsan, msan"
            exit 1
            ;;
    esac
fi

# 覆盖率
if [[ "$COVERAGE" == "true" ]]; then
    CMAKE_ARGS+=(-DENABLE_COVERAGE=ON)
fi

# LTO
if [[ "$LTO" == "false" ]]; then
    CMAKE_ARGS+=(-DENABLE_LTO=OFF)
fi

# 静态分析
if [[ "$STATIC_ANALYSIS" == "true" ]]; then
    CMAKE_ARGS+=(-DENABLE_CLANG_TIDY=ON)
fi

# CPU baseline
if [[ -n "$CPU_BASELINE" ]]; then
    CMAKE_ARGS+=(-DFQTOOLS_CPU_BASELINE="$CPU_BASELINE")
fi

if command -v conan &>/dev/null; then
    # 规范化为绝对路径：CMake 会把 FILEPATH 缓存项规范成绝对路径，
    # 用相对路径比较会永久误判"toolchain 变化"，导致每次运行都清空重建
    case "${BUILD_DIR}" in
        /*) TOOLCHAIN_PATH="${BUILD_DIR}/conan_toolchain.cmake" ;;
        *) TOOLCHAIN_PATH="${PROJECT_ROOT}/${BUILD_DIR}/conan_toolchain.cmake" ;;
    esac

    if [[ -f "${BUILD_DIR}/CMakeCache.txt" ]]; then
        # 缓存条目类型不固定（-D 裸传为 UNINITIALIZED，显式带类型为 FILEPATH），
        # 只比较值本身，避免因类型差异永久误判"toolchain 变化"
        # grep 无匹配返回 1，pipefail 下会静默终止脚本；此处"无匹配"是合法状态
        CACHE_TOOLCHAIN_VALUE=$(grep -E '^CMAKE_TOOLCHAIN_FILE[^=]*=' "${BUILD_DIR}/CMakeCache.txt" 2>/dev/null | head -n1 | cut -d'=' -f2- || true)
        if [[ "${CACHE_TOOLCHAIN_VALUE}" != "${TOOLCHAIN_PATH}" ]]; then
            if [[ "${BUILD_DIR_DEFAULTED}" == "true" ]]; then
                log_warning "检测到构建目录已存在且 toolchain 发生变化/未设置；将自动清理构建目录以确保 Conan toolchain 生效: ${BUILD_DIR}"
                safe_remove_dir "${BUILD_DIR}"
                ensure_directory "${BUILD_DIR}"
            else
                log_warning "检测到构建目录已存在且 toolchain 发生变化/未设置；请使用 --clean 重新配置以确保 Conan toolchain 生效"
            fi
        fi
    fi

    CONANFILE_PATH="build-config/dependencies/conanfile.py"
    LOCKFILE_PATH="conan.lock"
    CONANFILE_HASH_FILE="${BUILD_DIR}/conanfile.sha256"

    # 先解析本次要用的 profile，并纳入变更检测：切换 profile 或修改
    # profile 内容都要重新生成 toolchain，不能沿用旧依赖。
    CONAN_PROFILE="${CONAN_PROFILE_OVERRIDE}"
    if [[ -n "${CONAN_PROFILE}" ]]; then
        if [[ ! -f "${CONAN_PROFILE}" ]]; then
            log_error "指定的 Conan profile 不存在: ${CONAN_PROFILE}"
            exit 1
        fi
    else
        # 按主机架构选择仓库内的 host profile；ARM64 使用 armv8 语义的
        # profile-*-arm64，避免误用写死 arch=x86_64 的 x86 profile。
        CONAN_PROFILE="$(get_conan_profile "${COMPILER}" 2>/dev/null || true)"
        if [[ -z "${CONAN_PROFILE}" ]]; then
            log_warning "当前平台 $(detect_os)/$(uname -m 2>/dev/null || echo unknown) 没有内置 Conan profile，将使用 Conan 默认 profile"
        elif [[ ! -f "${CONAN_PROFILE}" ]]; then
            log_warning "未找到 Conan profile: ${CONAN_PROFILE}，将使用 Conan 默认 profile"
            CONAN_PROFILE=""
        else
            log_info "Conan host profile: ${CONAN_PROFILE}"
        fi
    fi

    CONAN_HASH_INPUTS=("${CONANFILE_PATH}")
    # --lockfile-out 回写经实测字节稳定（内容不变则文件不变），不会造成重装循环。
    if [[ -f "${LOCKFILE_PATH}" ]]; then
        CONAN_HASH_INPUTS+=("${LOCKFILE_PATH}")
    fi
    if [[ -n "${CONAN_PROFILE}" && -f "${CONAN_PROFILE}" ]]; then
        CONAN_HASH_INPUTS+=("${CONAN_PROFILE}")
    fi
    CURRENT_CONANFILE_HASH=$(cat "${CONAN_HASH_INPUTS[@]}" | sha256sum | cut -d' ' -f1)

    NEED_CONAN_INSTALL=false
    if [[ ! -f "${TOOLCHAIN_PATH}" ]]; then
        NEED_CONAN_INSTALL=true
    elif [[ ! -f "${CONANFILE_HASH_FILE}" ]] || [[ "$(cat "${CONANFILE_HASH_FILE}" 2>/dev/null)" != "${CURRENT_CONANFILE_HASH}" ]]; then
        log_info "检测到 conanfile.py/conan.lock/profile 发生变化，将重新生成 Conan 依赖"
        NEED_CONAN_INSTALL=true
    fi

    if [[ "$NEED_CONAN_INSTALL" == "true" ]]; then
        log_info "检测到 Conan，正在生成依赖（首次构建可能较慢）"

        CONAN_BUILD_TYPE="${BUILD_TYPE}"
        if [[ "${CONAN_BUILD_TYPE}" == "Coverage" ]]; then
            CONAN_BUILD_TYPE="Debug"
        fi

        # 没有显式 host profile 时才需要默认 profile（build context）。
        if [[ -z "${CONAN_PROFILE}" ]] &&
            ! conan profile list 2>/dev/null | grep -Fxq default; then
            log_info "未找到 Conan 默认 profile，执行 conan profile detect"
            conan profile detect --force
        fi

        # tools.build:jobs 默认按 Conan 的 CPU 探测（容器里可能读到宿主 192 核，
        # 实际 cpuset 只有 21 核），显式对齐脚本的 JOBS 避免源码构建超订。
        CONAN_ARGS=(install build-config/dependencies/ --build=missing -of="${BUILD_DIR}"
                    -s "build_type=${CONAN_BUILD_TYPE}" -c "tools.build:jobs=${JOBS}")
        CONAN_ARGS+=(-o "fastqtools/*:build_testing=True")
        CONAN_ARGS+=(-o "fastqtools/*:build_benchmarks=False")
        if [[ -f "${LOCKFILE_PATH}" ]]; then
            # 强制使用入库的锁定依赖图，并回写更新（字节稳定，不产生无谓 diff）
            CONAN_ARGS+=(--lockfile="${LOCKFILE_PATH}" --lockfile-out="${LOCKFILE_PATH}")
        fi
        if [[ -n "${CONAN_PROFILE}" && -f "${CONAN_PROFILE}" ]]; then
            CONAN_ARGS+=(-pr:h "${CONAN_PROFILE}")
            # 原生构建：build context 复用同一 profile。否则 default profile 可能
            # 声明 clang 却调用 cc/g++，向 GCC 注入它不认识的 -stdlib=libstdc++。
            CONAN_ARGS+=(-pr:b "${CONAN_PROFILE}")
        elif conan profile list 2>/dev/null | grep -Fxq default; then
            CONAN_ARGS+=(-pr:b default)
        fi

        # host/build 两个上下文都要对齐本机编译器大版本，避免 profile 写死的
        # 版本（如 GCC 15）与本机实际版本（如 13）不一致。
        LOCAL_COMPILER_VERSION=""
        if [[ -n "${CONAN_COMPILER_VERSION_OVERRIDE}" ]]; then
            LOCAL_COMPILER_VERSION="${CONAN_COMPILER_VERSION_OVERRIDE}"
        elif [[ -n "${CONAN_PROFILE}" && -f "${CONAN_PROFILE}" ]]; then
            # 仅在使用仓库 profile 时按本机版本覆盖；macOS 走 Conan 默认
            # profile（apple-clang），其版本已由 conan profile detect 对齐。
            if [[ "${COMPILER}" == "clang" ]]; then
                LOCAL_COMPILER_VERSION=$(clang -dumpversion 2>/dev/null | cut -d. -f1 || true)
            elif [[ "${COMPILER}" == "gcc" ]]; then
                LOCAL_COMPILER_VERSION=$(g++ -dumpfullversion -dumpversion 2>/dev/null | cut -d. -f1 || true)
            fi
        fi
        if [[ -n "${LOCAL_COMPILER_VERSION}" ]]; then
            CONAN_ARGS+=(-s "compiler.version=${LOCAL_COMPILER_VERSION}")
            CONAN_ARGS+=(-s:b "compiler.version=${LOCAL_COMPILER_VERSION}")
        fi

        if [[ "$VERBOSE" == "true" && -n "${CONAN_COMPILER_VERSION_OVERRIDE}" ]]; then
            log_debug "Conan 编译器版本覆盖: ${CONAN_COMPILER_VERSION_OVERRIDE}"
        fi

        if [[ "$VERBOSE" == "true" ]]; then
            log_debug "Conan 参数: conan ${CONAN_ARGS[*]}"
        fi

        if ! conan "${CONAN_ARGS[@]}"; then
            log_error "Conan 依赖安装失败"
            if [[ -f "${LOCKFILE_PATH}" ]]; then
                log_error "若因 conanfile.py 依赖变更与锁定文件不同步，请先重新生成：conan lock create ${CONANFILE_PATH} --lockfile-out=${LOCKFILE_PATH}"
            fi
            exit 1
        fi

        # 记录 conanfile.py 校验和，下次构建时比对以触发依赖更新
        echo "${CURRENT_CONANFILE_HASH}" > "${CONANFILE_HASH_FILE}"
    fi

    if [[ -f "${TOOLCHAIN_PATH}" ]]; then
        CMAKE_ARGS+=(-DCMAKE_TOOLCHAIN_FILE="${TOOLCHAIN_PATH}")
    fi
else
    log_warning "未检测到 conan，若依赖缺失请先安装 conan 或运行 ./scripts/core/install-deps --dev"
fi

# =============================================================================
# CMake 配置
# =============================================================================
show_step 2 4 "配置 CMake"

if [[ "$VERBOSE" == "true" ]]; then
    log_debug "CMake 参数: ${CMAKE_ARGS[*]}"
fi

if ! cmake "${CMAKE_ARGS[@]}"; then
    log_error "CMake 配置失败"
    exit 1
fi

log_success "CMake 配置完成"

# =============================================================================
# 构建
# =============================================================================
show_step 3 4 "编译项目"

if [[ "$USE_CMAKE_PRESET" == "true" ]]; then
    BUILD_ARGS=(
        --build
        --preset "$ACTIVE_PRESET"
        --parallel "$JOBS"
    )
else
    BUILD_ARGS=(
        --build "$BUILD_DIR"
        --parallel "$JOBS"
    )
fi

if [[ "$VERBOSE" == "true" ]]; then
    BUILD_ARGS+=(--verbose)
fi

if ! cmake "${BUILD_ARGS[@]}"; then
    log_error "编译失败"
    exit 1
fi

log_success "编译完成"

# =============================================================================
# 输出构建信息
# =============================================================================
show_step 4 4 "生成构建报告"

BINARY_PATH="${BUILD_DIR}/FastQTools"
if [[ -f "$BINARY_PATH" ]]; then
    BINARY_SIZE=$(du -h "$BINARY_PATH" | cut -f1)
    log_success "可执行文件: ${BINARY_PATH} (${BINARY_SIZE})"
else
    log_warning "可执行文件未找到: ${BINARY_PATH}"
fi

# 编译数据库
if [[ -f "${BUILD_DIR}/compile_commands.json" ]]; then
    log_success "编译数据库: ${BUILD_DIR}/compile_commands.json"
fi

log_separator "="
end_timer
log_separator "="

if [[ "$DEV_MODE" == "true" ]]; then
    log_info "开发模式提示:"
    log_info "  运行测试: ./scripts/core/test --build-dir ${BUILD_DIR}"
    log_info "  代码格式: ./scripts/core/lint format"
    log_info "  静态检查: ./scripts/core/lint check"
fi
