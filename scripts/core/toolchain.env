#!/usr/bin/env bash
# scripts/core/toolchain.env
#
# 工具链预期版本的单一事实来源。被 scripts/core/doctor 消费；
# 数值与 .github/workflows/ci.yml 的 env 及 .github/actions/setup-cpp 默认值保持同步——
# 修改其中一方时必须同步另一方（CI 是基准）。

# LLVM 工具链大版本（clang-format / clang-tidy / clang 编译器）
# 对应 ci.yml env.LLVM_VERSION 与 setup-cpp 的 llvm-version 默认值；
# 线上通过 apt.llvm.org 安装并 update-alternatives 钉住裸命令，本地应对齐
EXPECTED_LLVM_VERSION="21"

# CMake 硬性下限：CMakeLists.txt 的 cmake_minimum_required，低于即无法配置
EXPECTED_CMAKE_MIN="3.28"
# CI 锁定版本（ci.yml env.CMAKE_VERSION），仅作对齐建议，不作硬性要求
EXPECTED_CMAKE_CI="4.3.4"

# Conan：要求 2.x（Conan 1 命令与缓存布局不兼容）；CI 锁定 2.27.1
EXPECTED_CONAN_MAJOR="2"
EXPECTED_CONAN_CI="2.27.1"

# 编译器支持 C++23 的实际下限（低于则构建可能失败），CI 分别为 GCC 15 / LLVM 21
EXPECTED_GCC_MIN="12"
EXPECTED_CLANG_MIN="16"

# e2e 测试（tests/e2e）依赖 python3
EXPECTED_PYTHON_MIN="3.8"
